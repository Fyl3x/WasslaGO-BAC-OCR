# Copy to .env and edit. Every value is optional.
HOST=127.0.0.1
PORT=5000
MAX_UPLOAD_MB=25
MAX_PAGES=10

# Only needed when tesseract is not on PATH (typical on Windows):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Folder with extra traineddata (e.g. tessdata_best for noticeably better Arabic):
# TESSDATA_DIR=/opt/tessdata_best

OCR_WORKERS=4
PDF_RENDER_DPI=300
SAVE_DEBUG_IMAGES=true

# --- Production / Docker ---
# Password-protect the site (recommended on a public server). Leave empty to disable.
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASSWORD=change-me-to-a-long-password
SECRET_KEY=change-me
RETENTION_HOURS=24
